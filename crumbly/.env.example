# --- App ---
NODE_ENV=development
PORT=8080
WEB_URL=http://localhost:5173
API_URL=http://localhost:8080
# --- Firebase Admin (server only) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# --- AI (server only) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=            # set to a current Gemini model id from Google AI Studio docs
# --- Daraja (server only) ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# --- Google Maps (server only; enable Places API (New) + Routes API, restrict the key to those APIs and your server IP) ---
GOOGLE_MAPS_SERVER_KEY=
# --- Web (public Firebase config only) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Long random string. It becomes part of the Daraja callback URL path and is checked on every callback.
MPESA_CALLBACK_SECRET=
# DARAJA_CALLBACK_URL is built as ${API_URL}/api/payments/mpesa/callback/${MPESA_CALLBACK_SECRET} (must be public HTTPS)
# true = bakeries go live as soon as the owner publishes. Set false once the admin approval screen exists.
BAKERY_AUTO_APPROVE=true
# Secret for the scheduler that calls POST /api/internal/reconcile-payments (header x-reconcile-secret). Leave empty to disable the endpoint.
RECONCILE_SECRET=
# Number of reverse proxies in front of the API (1 on Cloud Run / Render / Railway)
TRUST_PROXY_HOPS=0

# --- Local development against the Firebase emulators (no real Firebase project needed) ---
# Uncomment these, then run `npm run emulators`, `npm run seed` and `npm run dev` from the repo root.
# FIREBASE_PROJECT_ID=crumbly-dev
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# VITE_FIREBASE_PROJECT_ID=crumbly-dev
# VITE_USE_EMULATORS=true
# Required (any 16+ character strings are fine locally):
# MPESA_CALLBACK_SECRET=local-dev-secret-123
# Also set WEB_URL=http://localhost:5173 and API_URL=http://localhost:8080
# Email notifications via Resend (optional; without these, emails are skipped and only in-app notifications are created)
RESEND_API_KEY=
EMAIL_FROM="Crumbly <orders@yourdomain.com>"
